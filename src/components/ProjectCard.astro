---
interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  /** Where the card links to. External links open in a new tab. */
  href?: string;
}
const { title, description, image, imageAlt, href } = Astro.props;
const external = href?.startsWith('http');
---

<article class:list={['card', { 'is-link': href }]} data-aura-focus>
  <div class="media">
    <img src={image} alt={imageAlt} width="440" height="179" loading="lazy" decoding="async" />
  </div>
  <div class="body">
    <h3>
      {href ? (
        <a class="card-link" href={href} {...(external && { target: '_blank', rel: 'noopener' })}>
          {title}
          {external && <span class="visually-hidden"> (opens in a new tab)</span>}
        </a>
      ) : (
        title
      )}
    </h3>
    <p>{description}</p>
  </div>
</article>

<style>
  /* Figma: card 34:316 */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: clip;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 16px;
  }
  /* The whole card is clickable: the title link stretches over it */
  .card-link {
    color: inherit;
    text-decoration: none;
  }
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card-link:focus-visible {
    outline: none;
  }
  .card.is-link {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .card.is-link:hover {
    transform: translateY(-3px);
    border-color: rgba(109, 78, 89, 0.32);
    box-shadow: 0 18px 40px -24px rgba(70, 35, 52, 0.45);
  }
  .card.is-link:has(.card-link:focus-visible) {
    outline: 2px solid var(--quote-mark);
    outline-offset: 3px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .card.is-link,
    .card.is-link:hover {
      transition: none;
      transform: none;
    }
  }
  .media {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 335px;
    background: var(--card-media);
  }
  .media img {
    width: 440px;
    max-width: 68.7%;
    height: auto;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px;
  }
  h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 32px;
    line-height: 0.93;
    color: var(--ink-heading);
  }
  p {
    font-family: var(--sans-text);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.22;
    letter-spacing: -0.32px;
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .media {
      height: auto;
      aspect-ratio: 640.5 / 335;
    }
    .body {
      padding: 24px;
    }
    h3 {
      font-size: 28px;
    }
  }
</style>
